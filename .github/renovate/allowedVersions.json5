{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/postgresql/", "/postgres-backup-local/"],
      "allowedVersions": "<18"
    },
    {
      // redhat versioning (customManagers.json5) cannot parse the -system-trixie suffix.
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/cloudnative-pg/postgresql"],
      "versioning": "docker"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/blakeblackshear/frigate"],
      "versioning": "semver",
      "ignoreUnstable": false,
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+(-beta\\d+)?$/"
    },
    {
      // Paperless does not support Tika 4: Tika 4 removed the /form endpoints
      // that Paperless calls. Remove this rule when Paperless supports Tika 4.
      // https://github.com/paperless-ngx/paperless-ngx/issues/13755
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/apache/tika", "apache/tika"],
      "allowedVersions": "<4"
    },
    {
      // kustomize and jq put a prefix on their release tags (kustomize/v5.8.3,
      // jq-1.8.2), which semver versioning rejects. These rules are for the
      // regex manager, which reads them from
      // kubernetes/apps/ai/claude-code/app/resources/tools.env. The mise
      // manager sets its own extractVersion.
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["kubernetes-sigs/kustomize"],
      "extractVersion": "^kustomize/(?<version>v.+)$"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["jqlang/jq"],
      "extractVersion": "^jq-(?<version>.+)$"
    }
  ]
}

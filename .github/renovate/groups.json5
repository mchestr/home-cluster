{
  packageRules: [
    {
      description: "Renovate image: look up the GitHub release like the config validator does, so the image and the validator stay on one version.",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/renovatebot/renovate"],
      overrideDatasource: "github-releases",
      overridePackageName: "renovatebot/renovate",
    },
    {
      description: "Renovate",
      groupName: "Renovate",
      matchPackageNames: ["renovatebot/renovate", "ghcr.io/renovatebot/renovate"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "1Password Group",
      groupName: "1Password",
      matchPackageNames: ["/1password/"],
      matchDatasources: ["docker"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      separateMinorPatch: true,
    },
    {
      description: "Flux Group",
      groupName: "Flux",
      matchPackageNames: ["/flux/"],
      matchDatasources: ["docker", "github-tags"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      separateMinorPatch: true,
    },
    {
      description: "Immich images: look up the GitHub release, which both images are tagged with. The machine-learning image has too many ghcr.io tags to page through without HTTP 429 errors.",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/immich-app/immich-server", "ghcr.io/immich-app/immich-machine-learning"],
      overrideDatasource: "github-releases",
      overridePackageName: "immich-app/immich",
    },
    {
      description: "Immich images",
      groupName: "Immich",
      matchPackageNames: ["/immich/"],
      matchDatasources: ["docker", "github-releases"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      separateMinorPatch: true,
    },
    {
      description: "Waitlist images: the browser pods must run the release waitlist-control expects",
      groupName: "Waitlist",
      matchPackageNames: ["/^ghcr\\.io/mchestr/waitlist-(control|browser|vnc-edge)$/"],
      matchDatasources: ["docker"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Rook-Ceph image and chart",
      groupName: "Rook-Ceph",
      matchPackageNames: ["/rook.ceph/"],
      matchDatasources: ["docker", "helm"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      separateMinorPatch: true,
    },
    {
      description: "Kubernetes Upgrade Group",
      groupName: "Kubernetes",
      matchPackageNames: [
        "/siderolabs/kubelet/",
        "/registry.k8s.io/kubectl/"
      ],
      matchDatasources: ["docker", "github-releases"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      separateMinorPatch: true,
    },
    {
      description: "Talos Upgrade Group",
      groupName: "Talos",
      matchPackageNames: [
        "/siderolabs/talos/",
        "/ghcr.io/siderolabs/talosctl/",
      ],
      matchDatasources: ["docker", "github-releases", "container"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      separateMinorPatch: true,
    },
  ],
}

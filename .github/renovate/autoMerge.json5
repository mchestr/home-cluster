{
  // Renovate asks GitHub to auto-merge the PRs it opens for automerge updates.
  // GitHub auto-merge only waits for required status checks, and main has none,
  // so it would skip the risk assessment. Renovate's own automerge waits for
  // every check.
  platformAutomerge: false,
  packageRules: [
    {
      description: "Auto merge minor, patch and digest updates once they have aged a bit",
      matchDatasources: [
        "docker",
        "github-releases",
        "github-tags",
        "helm",
        "terraform-provider",
      ],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "branch",
      minimumReleaseAge: "2 days",
      // Registries that do not publish release timestamps would otherwise hold updates forever
      minimumReleaseAgeBehaviour: "timestamp-optional",
    },
    {
      description: "0.x minor bumps are effectively breaking, keep them as PRs",
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "/^v?0\\./",
      automerge: false,
    },
    {
      description: "Core infrastructure and apps with risky DB migrations always get a PR",
      matchPackageNames: [
        // CNI, gateway, DNS, image mirror
        "/cilium/",
        "/envoy/",
        "/coredns/",
        "/spegel/",
        // Storage and backups
        "/rook/",
        "/ceph/",
        "/openebs/",
        "/volsync/",
        "/snapshot-controller/",
        // GitOps, node and cluster upgrades
        "/flux/",
        "/siderolabs/",
        "/tuppr/",
        // Shared chart used by nearly every app
        "/app-template/",
        // Cluster-wide controllers
        "/cert-manager/",
        "/external-secrets/",
        "/litellm-operator/",
        // Databases and apps with DB migrations
        "/cloudnative-pg/",
        "/postgres/",
        "/immich/",
        "/windmill/",
        "/waitlist/",
      ],
      automerge: false,
    },
    {
      description: "Auto merge Renovate majors too, so the pinned Renovate version never waits for a manual merge. The risk assessment still gates each update.",
      matchDatasources: ["github-releases"],
      matchPackageNames: ["renovatebot/renovate"],
      matchUpdateTypes: ["major"],
      automerge: true,
      automergeType: "branch",
      minimumReleaseAge: "2 days",
    },
    {
      description: "Auto merge Claude Code, which the risk assessment workflow installs from npm",
      matchDatasources: ["npm"],
      matchPackageNames: ["@anthropic-ai/claude-code"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "branch",
      minimumReleaseAge: "2 days",
    },
    {
      description: ["Auto-merge GitHub Actions"],
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
    },
    {
      description: "Renovate only gets release dates from Docker Hub, so images and OCI charts on other registries (ghcr.io, quay.io, registry.k8s.io, ...) can't be aged and were already skipping minimumReleaseAge under timestamp-optional, with a warning every run. Don't ask for an age there; the risk assessment is their check before merging. Last so it also covers docker:// actions.",
      matchDatasources: ["docker"],
      matchPackageNames: ["/^[^/]+\\.[^/]+\\//", "!/^(index\\.)?docker\\.io\\//"],
      minimumReleaseAge: null,
    },
  ],
}

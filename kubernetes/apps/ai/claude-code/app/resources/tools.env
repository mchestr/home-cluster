# CLI versions installed by install-tools.sh. Kept in a .env file so Renovate's
# custom regex manager picks them up.
# renovate: datasource=github-releases depName=kubernetes/kubernetes
KUBECTL_VERSION=v1.36.5
# renovate: datasource=github-releases depName=fluxcd/flux2
FLUX_VERSION=v2.9.6
# renovate: datasource=github-releases depName=controlplaneio-fluxcd/flux-operator
FLUX_OPERATOR_VERSION=v0.61.0
# Keep in step with kubernetes/apps/system-upgrade/tuppr/upgrades/talos.yaml.
# renovate: datasource=github-releases depName=siderolabs/talos
TALOS_VERSION=v1.14.2
# renovate: datasource=github-releases depName=go-task/task
TASK_VERSION=v3.54.0
# renovate: datasource=github-releases depName=cli/cli
GH_VERSION=v2.102.0
# renovate: datasource=github-releases depName=helm/helm
HELM_VERSION=v4.3.1
KUSTOMIZE_VERSION=v5.8.3
# renovate: datasource=github-releases depName=mikefarah/yq
YQ_VERSION=v4.54.1
JQ_VERSION=1.8.2
